  "history": [
    {
      "title": "381年\n創建",
      "text": "在高句麗小獸林王十一年，僧人阿道於此建立晉宗寺，開啟了傳燈寺悠久的歷史。三國時期，這座寺院逐漸發展為重要的佛教中心。"
    },
    {
      "title": "1282年\n改名為傳燈寺",
      "text": "在貞和宮主的布施供養之下，寺中奉安了宋代《法華經》，寺名也因此更改為「傳燈寺」。自此以後，傳燈寺成為兼具教學與修行、並肩負國家佛教功能的重要道場。"
    },
    {
      "title": "1621年\n大規模重建",
      "text": "1605年與1614年的火災使殿堂相繼燒毀，自1615年起展開的大規模重建工程，於1621年由智敬僧人舉行上樑儀式後告一段落。今日傳燈寺的核心伽藍格局，大多形成於此時期。"
    },
    {
      "title": "1726年\n與王室的因緣",
      "text": "英祖親賜「醉香堂」匾額，大幅提升了傳燈寺的地位。王室的特別關注顯示出，傳燈寺並非普通地方寺院，而是具有國家象徵意義的寺院。"
    },
    {
      "title": "18世紀\n國家層級的角色",
      "text": "傳燈寺內設有史庫與儲糧倉，用以保存王室檔案與軍糧。這顯示傳燈寺不僅是信仰空間，也在國家政務中扮演了重要角色。"
    },
    {
      "title": "1911年\n近代的傳燈寺",
      "text": "《寺刹令》頒布後，傳燈寺被指定為本寺，統攝江華、開城、金浦等地共34座寺院。整個20世紀間，大雄殿、冥府殿、大照樓、三星閣等陸續重建，伽藍配置日益完備。"
    },
    {
      "title": "今日\n傳統與現在",
      "text": "傳燈寺保存了包括寶物級殿堂、木刻版與佛像在內的眾多文化資產。同時，透過三郞城歷史文化祭、寺院體驗與文化活動等，持續在傳統與現代之間搭起橋樑，成為一座充滿生命力的寺院。"
    }
  ],
  "heritage": [
    {
      "imagePath": "assets/page02/UI_Page02_1.jpg",
      "title": "大雄寶殿",
      "description": "寶物第178號\n大雄寶殿建於1621年，是一座面寬三間、側面三間的木結構建築，以其端莊的結構和精緻的雕刻裝飾，被譽為朝鮮中期建築的代表作。",
      "video": "https://youtu.be/O8RkgSDHQ70"
    },
    {
      "imagePath": "assets/page02/UI_Page02_2.jpg",
      "title": "藥師殿",
      "description": "寶物第179號\n藥師殿位於大雄寶殿西側，是朝鮮中期多包式建築，面寬三間、側面三間，屋頂呈八作式。其結構和裝飾與大雄寶殿相似。",
      "video": ""
    },
    {
      "imagePath": "assets/page02/UI_Page02_3.jpg",
      "title": "傳燈寺鐵鐘",
      "description": "寶物第393號\n這是一口1097年於中國宋明寺鑄造的獨特形態之鐘，曾被日本帝國主義掠奪，光復後尋回並歸還傳燈寺。",
      "video": ""
    },
    {
      "imagePath": "assets/page02/UI_Page02_4.jpg",
      "title": "木造釋迦如來三佛坐像",
      "description": "此佛像為1623年由修練(Suyeon)擔任首畫僧參與製作的三世佛形式，本尊釋迦佛展現出穩定的比例和洗練的雕刻美學。",
      "video": ""
    },
    {
      "imagePath": "assets/page02/UI_Page02_5.jpg",
      "title": "木造地藏菩薩三尊像及十王像一括",
      "description": "傳燈寺冥府殿的地藏菩薩像及眷屬31尊造於1636年，地藏三尊像和十王像造型獨特優美，保存狀態良好。",
      "video": ""
    },
    {
      "imagePath": "assets/page02/UI_Page02_6.jpg",
      "title": "妙法蓮華經木版",
      "description": "這是1543年在淨水寺復刻的，由雕刻大乘經典《法華經》的104塊木板和411張紙組成。保存狀態良好但有部分損壞，朝鮮戰爭時期遺失了1塊木板。",
      "video": ""
    },
    {
      "imagePath": "assets/page02/UI_Page02_7.jpg",
      "title": "明鏡台",
      "description": "這是一對1627年製作的佛教木工藝品，描繪了青色和黃色的獅子托舉著火焰紋鏡子，象徵著地獄中映照罪孽的鏡子。被評價為朝鮮後期佛教木工藝研究的重要資料。",
      "video": ""
    }
  ],
